        "field": "y",
        "value": 100,
        "hlc": "0000000001000:00005:user_a"
      }
    ],
    "expectState": {
      "obj_1": {
        "y": { "value": 250, "hlc": "0000000002000:00000:user_b" }
      }
    },
    "expectHash": ""
  },
