        "x": { "value": 42, "hlc": "0000000001000:00000:user_a" }
      }
    },
    "expectHash": ""
  },
  {
    "name": "stale op with lower HLC is discarded",
    "comment": "When a newer op (pt=2000) arrives before an older op (pt=1000), the older op is discarded and the newer value stays.",
    "ops": [
      {
        "objectId": "obj_1",
        "field": "y",
        "value": 250,
        "hlc": "0000000002000:00000:user_b"
      },
