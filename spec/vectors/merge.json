        "field": "fill",
        "value": "#3B82F6",
        "hlc": "0000000001000:00000:user_b"
      }
    ],
    "expectState": {
      "obj_1": {
        "x": {
          "value": 120,
          "hlc": "0000000001000:00000:user_a"
        },
        "fill": {
          "value": "#3B82F6",
          "hlc": "0000000001000:00000:user_b"
        }
      }
    },
    "expectHash": "b81888d071b0670ecada7b0db7d61831c5e0144a6944fc42b9587375b93142c8"
  },
