[
  {
    "name": "concurrent move and recolor on different fields both survive",
    "comment": "LWW-Map is field-granular: ops touching x and fill on obj_1 occupy independent registers, so both values survive.",
    "ops": [
      {
        "objectId": "obj_1",
        "field": "x",
        "value": 120,
        "hlc": "0000000001000:00000:user_a"
      },
      {
        "objectId": "obj_1",
        "field": "fill",
        "value": "#3B82F6",
        "hlc": "0000000001000:00000:user_b"
      }
    ],
    "expectState": {
      "obj_1": {
        "x": { "value": 120, "hlc": "0000000001000:00000:user_a" },
        "fill": { "value": "#3B82F6", "hlc": "0000000001000:00000:user_b" }
      }
    },
    "expectHash": ""
  },
  {
    "name": "higher physicalTime wins on same field",
    "comment": "physicalTime 2000 > 1000, so x=20 replaces x=10.",
    "ops": [
      {
        "objectId": "obj_1",
        "field": "x",
        "value": 10,
        "hlc": "0000000001000:00009:user_b"
      },
      {
        "objectId": "obj_1",
        "field": "x",
        "value": 20,
        "hlc": "0000000002000:00000:user_a"
      }
    ],
    "expectState": {
      "obj_1": {
        "x": { "value": 20, "hlc": "0000000002000:00000:user_a" }
      }
    },
    "expectHash": ""
  },
  {
    "name": "higher counter wins when physicalTime ties",
